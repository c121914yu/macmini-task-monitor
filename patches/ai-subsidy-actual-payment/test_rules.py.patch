+                result=evaluate(form('133.46',currency='人民币'),e,POLICY,
+                    lambda month:{'date':month+'-02','usd_cny':rate},{},['paymenthash'],TODAY)
+                self.assertEqual(result['monthly_full_cost_cny'],'133.46')
+                self.assertEqual(result['allocations'][0]['subsidy_cny'],'66.73')
