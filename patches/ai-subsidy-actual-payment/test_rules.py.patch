+    def test_explicit_cny_settlement_uses_actual_amount_and_cny_unit(self):
+        e=facts();e['purchases'][0]['settled_cny']='133.46'
+        result=review(form('133.46',currency='人民币'),e)
+        self.assertEqual(result['action'],'approve')
+        self.assertEqual(result['monthly_full_cost_cny'],'133.46')
+        self.assertEqual(result['allocations'][0]['subsidy_cny'],'66.73')
+        self.assertIn('实际支付金额133.46元',comment_for(result,POLICY))
+        wrong=review(form('134.29',currency='美元'),e)
+        self.assertEqual(wrong['action'],'reject')
+        self.assertIn('支付币种填写有误，应选人民币',wrong['reasons'])
+        self.assertEqual(wrong['expected_cost_cny'],'133.46')
+        self.assertEqual(e['purchases'][0]['paid_amount'],'20.00')
+        self.assertEqual(e['purchases'][0]['currency'],'USD')
+
+    def test_cny_payment_cost_does_not_change_with_cap_exchange_rate(self):
