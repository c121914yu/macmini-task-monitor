+def payment_basis(purchase, policy):
+    """原始交易事实保持不变；明确人民币入账优先作为实付依据，拒绝猜测或使用预计换算。"""
+    currency, amount = purchase['currency'], purchase['paid_amount']
+    settled = purchase.get('settled_cny', '').strip()
+    if not policy.get('usd_orders_use_original_currency', True) and currency == 'USD' and settled:
+        if money(settled) <= 0:
+            raise Hold('人民币入账金额无效，需人工核验')
+        return 'CNY', settled
+    return currency, amount
