+def folder_valid(root, folder, record=None):
+    """普通任务保持严格命名；人工冲突任务还须交叉验证任务元数据和受管副本。"""
+    root, folder = Path(root), Path(folder)
+    if folder.is_symlink() or folder.parent not in {root/'runs', root/'dependency-runs'}:
+        return False
+    if re.fullmatch(r'\d+-[0-9a-f]{12,64}', folder.name):
+        return True
+    # 人工处理也是已登记的工作副本，但不能仅放宽正则就授予删除权限。
+    if folder.parent != root/'runs' or not re.fullmatch(r'\d+-conflict-resolution-[0-9a-f]{12}', folder.name):
+        return False
+    evidence = folder/'job.json'
+    if evidence.is_symlink():
+        return False
+    try:
+        job = life.read(evidence)
+        key, number = job.get('key', ''), job.get('number')
+        if (type(number) is not int or number <= 0 or not re.fullmatch(r'[0-9a-f]{64}', key)
+                or job.get('purpose') != 'manual conflict resolution requested by user'
+                or folder.name != f'{number}-conflict-resolution-{key[:12]}'
+                or job.get('folder') != str(folder)):
+            return False
+        worktree = life.workspace_path(root, job)
+        if job.get('worktree') != str(worktree) or not life.owned(root, worktree):
+            return False
+        if record is not None:
+            return (record.get('managed_by') == 'fastgpt-pr-review'
+                    and record.get('channel') == 'runs'
+                    and record.get('pr') == number and record.get('key') == key
+                    and record.get('path') == str(worktree)
+                    and record.get('head') == job.get('head_sha'))
+        return True
+    except (ValueError, TypeError, OSError):
+        return False
 
 
