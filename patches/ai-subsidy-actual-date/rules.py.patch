+    def monthly_costs():
+        # 按凭证付款月取汇率，按各订阅覆盖月分摊。人民币只为美元等值额度折算。
+        rates, pending = {}, []
+        full_cost_cny = D(0)
+        for payment in payments:
+            payment_month = payment['paid'].strftime('%Y-%m')
+            if payment_month not in rates:
+                rates[payment_month] = fx(payment_month)
+            rate = rates[payment_month]
+            usd_cny = money(rate['usd_cny'])
+            total, cycle = payment['total'], payment['cycle']
+            is_usd = payment['currency'] == 'USD'
+            monthly_cny = (total * usd_cny if is_usd else total) / cycle
+            monthly_usd = (total if is_usd else total / usd_cny) / cycle
+            full_cost_cny += monthly_cny
+            for offset in range(payment['cycle']):
+                month = month_add(payment['start'].replace(day=1), offset).strftime('%Y-%m')
+                pending.append({'month': month, 'cost_usd': str(monthly_usd),
+                                'cost_cny': str(monthly_cny), 'fx_date': rate['date'],
+                                'usd_cny': rate['usd_cny'], 'payment_month': payment_month,
+                                'product': payment['product']})
+        return full_cost_cny, pending
+
